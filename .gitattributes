# Line-ending policy for this fork: every text file is LF in the repository (normalised in 27811a59).
# Upstream still ships CRLF files, so merges from upstream/hbm must use `git merge -Xrenormalize`
# (or `git config merge.renormalize true` once per clone). tools/check-fork.sh fails on any CRLF file.
# Catch-all: any other file git detects as text is LF too (dotfiles, LICENSE*, changelog, .dae, .hmf, .ini);
# the explicit rules below take precedence for their patterns.
*            text=auto eol=lf
*.java       text eol=lf
*.json       text eol=lf
*.mcmeta     text eol=lf
*.lang       text eol=lf
*.obj        text eol=lf
*.cfg        text eol=lf
*.info       text eol=lf
*.md         text eol=lf
*.txt        text eol=lf
*.gradle     text eol=lf
*.properties text eol=lf
*.yml        text eol=lf
*.py         text eol=lf
*.lua        text eol=lf
*.sh         text eol=lf
*.frag       text eol=lf
*.vert       text eol=lf
gradlew      text eol=lf
*.bat        text eol=crlf
*.png -text
*.ogg -text
*.wav -text
*.mp3 -text
*.nbt -text
*.jar -text
